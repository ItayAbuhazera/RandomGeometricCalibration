# Data and large files
data/cifar-*
data/cifar-10-batches-py/
data/cifar-10-python.tar.gz
data/tiny-imagenet-200/
data/*.npy
data/*.npz

# Logs and outputs
logs/
*.log
*.out
*.err

# Model checkpoints (large)
# Calibration outputs are generated locally; keep them out of `git add .`.
calibration_results/**/*.csv
calibration_results/**/*.json
calibration_results/**/*.png
calibration_results/**/*.tex
calibration_results_smoke/
results/models/**/config.json
*.pth
!results/models/cifar10/resnet18/seed12/best_model.pth

# Python
__pycache__/
*.pyc

# IDE / OS
.idea/
.vscode/
*.lock

# Bundled conda environment (machine-specific)
.conda/
.local_tools/

# Generated figures and tables (regenerate from calibration_results/*.json)
figures/

# Generated paper tables (regenerate from calibration_results/*.json if needed)
latex_tables_statistics/*.tex
latex_tables_statistics/*.csv

# Local audit / cleanup notes (not part of paper artifacts)
repo_experiment_audit.md
repo_experiment_cleanup_summary.md

# Local Python build / lint caches
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/
*.pdf
